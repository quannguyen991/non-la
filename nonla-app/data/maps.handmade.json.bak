      "landmarks": [
        {
          "n": "Chùa Cầu",
          "en": "Japanese Covered Bridge",
          "t": "bridge",
          "at": [
            15.8772,
            108.3266
          ],
          "note": "The 18th-century covered bridge on the 20,000₫ note. Ticketed to cross.",
          "star": true
        },
        {
          "n": "Nhà cổ Phùng Hưng",
          "en": "Phung Hung Old House",
          "t": "house",
          "at": [
            15.87695,
            108.3262
          ],
          "note": "Two-storey merchant house beside the bridge. Trapdoor in the floor for flood season."
        },
        {
          "n": "Hội quán Quảng Đông",
          "en": "Cantonese Assembly Hall",
          "t": "hall",
          "at": [
            15.87765,
            108.327
          ],
          "note": "Cantonese congregation hall. Red-and-gold courtyard, dragon fountain."
        },
        {
          "n": "Xưởng thủ công mỹ nghệ",
          "en": "Handicraft Workshop",
          "t": "craft",
          "at": [
            15.87672,
            108.3268
          ],
          "note": "Working silk and lantern workshop. Short traditional music sets through the day."
        },
        {
          "n": "Bảo tàng Văn hoá Sa Huỳnh",
          "en": "Sa Huynh Culture Museum",
          "t": "museum",
          "at": [
            15.87768,
            108.3276
          ],
          "note": "Burial jars and bronze from the Sa Huynh culture, 2,000 years before the port."
        },
        {
          "n": "Nhà cổ Tấn Ký",
          "en": "Tan Ky Old House",
          "t": "house",
          "at": [
            15.87668,
            108.328
          ],
          "note": "Seven generations of one family. Japanese, Chinese and Vietnamese joinery in one room.",
          "star": true
        },
        {
          "n": "Hội quán Phúc Kiến",
          "en": "Fujian Assembly Hall",
          "t": "hall",
          "at": [
            15.8774,
            108.329
          ],
          "note": "The largest assembly hall. Dedicated to Thiên Hậu, protector of sailors.",
          "star": true
        },
        {
          "n": "Giếng Bá Lễ",
          "en": "Ba Le Well",
          "t": "well",
          "at": [
            15.8783,
            108.3287
          ],
          "note": "Cham-era well down a narrow alley. Cao lầu is said to need this water."
        },
        {
          "n": "Nhà thờ tộc Trần",
          "en": "Tran Family Chapel",
          "t": "house",
          "at": [
            15.8789,
            108.3272
          ],
          "note": "Private ancestral chapel in a walled garden. Still used by the family."
        },
        {
          "n": "Chùa Ông",
          "en": "Quan Cong Temple",
          "t": "temple",
          "at": [
            15.87752,
            108.3303
          ],
          "note": "Temple to general Quan Công, facing the market. Traders came here to swear oaths."
        },
        {
          "n": "Chợ Hội An",
          "en": "Hoi An Market",
          "t": "market",
          "at": [
            15.8768,
            108.3298
          ],
          "note": "Produce in the morning, cooked food all day. The cheapest prices in the old town.",
          "star": true
        },
        {
          "n": "Bến thuyền Bạch Đằng",
          "en": "Bach Dang Boat Pier",
          "t": "pier",
          "at": [
            15.87562,
            108.329
          ],
          "note": "Where the paper-lantern boats launch after dark. Agree the fare before boarding."
        }
      ],
      "art": {
        "_note": "Tranh vẽ tay dùng làm nền. KHÔNG phải bản đồ khảo sát: bố cục phố trong tranh là ấn tượng của người vẽ. Hai mốc dưới đây neo Chùa Cầu vào đúng cây cầu trong tranh và ấn định tỉ lệ + góc xoay, nên KHOẢNG CÁCH VÀ HƯỚNG GIỮA CÁC GHIM là thật; vị trí tuyệt đối so với từng mái nhà trong tranh thì không. Bản đồ chính xác là bản vector ở Open full map.",
        "src": "assets/maps/hoian-oldtown.jpg",
        "w": 1536,
        "h": 1024,
        "alt": "Illustrated aerial view of Hoi An Old Town: tiled roofs, the Japanese Covered Bridge and the river",
        "anchors": [
