          }
        ]
      },
      "routes": [
        {
          "id": "lantern-walk",
          "name": "Lantern Walk Route",
          "blurb": "Wander slowly, greet locals, and let Hội An find you.",
          "stops": [
            {
              "ref": "sight:0",
              "tip": "Visit at sunset for the best lantern reflections on the water."
            },
            {
              "ref": "sight:5",
              "tip": "Ask to see the flood marks on the wall — they go up past head height."
            },
            {
              "ref": "sight:6",
              "tip": "The courtyard is quietest just after it opens."
            },
            {
              "ref": "sight:11",
              "tip": "Agree the boat price before stepping in, and count the lanterns you get."
            }
          ]
        }
      ]
    },
