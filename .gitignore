node_modules/
*.log

# sổ ghi tiến độ và bản nháp của quy trình subagent — là giấy nháp, không phải lịch sử
.superpowers/
.DS_Store
Thumbs.db

# khoá và cấu hình riêng — anon key của Supabase là công khai, nhưng
# service_role key thì không bao giờ được vào repo
.env
.env.*

# bộ nhớ đệm truy vấn Overpass — 1,9 MB JSON thô để chạy lại tools/fetch-*.py
# mà không phiền máy chủ công cộng. Là giấy nháp, không phải dữ liệu ship.
nonla-app/data/_overpass_cache/

# bộ nhớ đệm bytecode của Python trong tools/ — sinh lại được, không phải mã nguồn
__pycache__/
*.pyc

# bản tải thô của sitemap GrabFood — 5MB giấy nháp, chạy lại lệnh là có
docs/_sitemap-*.json

# trọng số và ảnh tiền — không vào git
# Thư mục HUẤN LUYỆN: trọng số trung gian và ảnh không vào repo.
# Ảnh tiền không được công bố (Nghị định 87/2023), và bản .pt là sản phẩm
# trung gian — bản dùng thật là ONNX đã lượng tử hoá.
/tien-model/*.pt
/tien-model/*.onnx
/tien-model/anh/
/tien-model/anh-kho/
# Nhưng model app THẬT SỰ dùng thì phải có trong repo: nó là một phần của
# sản phẩm nộp, và thiếu nó thì bản clone chạy ra một app khác.
!nonla-app/tien-model/

# Prompt Log sinh ra chứa nguyên văn lịch sử làm việc. Nộp cho BTC thì có,
# đẩy lên repo công khai thì phải là quyết định riêng — không mặc định.
/docs/prompt-log.html
/docs/prompt-log.md
/docs/prompt-log.pdf

# Hồ sơ theo mẫu BTC: thông tin đội (ngày sinh, SĐT, email học sinh) KHÔNG lên
# repo công khai. Chỉ mẫu trống doi-thi.mau.json được commit; bản PDF/HTML dựng
# ra sẽ chứa thông tin ấy ngay khi docs/doi-thi.json được điền.
/docs/doi-thi.json
/docs/ho-so-du-thi-bang-b.html
/docs/ho-so-du-thi-bang-b.pdf

# khoá bản đồ: chèn lúc đẩy, không bao giờ vào repo
/nonla-app/config.khoa.js

# bộ đệm trả lời Overpass của tools/moc-that-osm.mjs
/.tmp-moc-osm/
